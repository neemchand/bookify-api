{
  "name": "bookify",
  "version": "1.0.0",
  "description": "Event booking API — Fastify, Prisma, PostgreSQL, Redis, Kafka",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:consumers": "tsx watch src/consumers/main.ts",
    "dev:worker": "tsx watch src/workers/expiry.worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.0",
    "close-with-grace": "^2.5.0",
    "env-schema": "^7.0.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
NODE_ENV=development
PORT=3010
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL (docker compose maps container 5432 -> host 5440)
DATABASE_URL=postgresql://bookify:bookify_dev_password@localhost:5440/bookify?schema=public
# Isolated database used by `pnpm test` — schema-reset (all data wiped) on every run
TEST_DATABASE_URL=postgresql://bookify:bookify_dev_password@localhost:5440/bookify_test?schema=public

# Redis (docker compose maps container 6379 -> host 6390)
REDIS_URL=redis://localhost:6390

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bookify-api

# Auth — generate a real secret: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# How long a PENDING booking holds seats before expiring
BOOKING_HOLD_MINUTES=10
